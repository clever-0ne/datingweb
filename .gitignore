# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — .env is listed on its own because the .env*.local pattern
# does not match it, so a hand-made .env would otherwise be committed.
.env
.env*.local

# The local database. Holds every account, balance and session, so it must
# never reach a repository. data/seed.json is the committed starting point.
/data/db.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch / logs
/_dev.log
/database/

# Local dev scripts and their output — verification harnesses, screenshots and
# cookie jars. Never part of the app.
/scripts/dev/
/scripts/out/

# Local run artefacts — never committed.
.server.log
scripts/out/
