# Copy to .env.local for local development, or set these in your Vercel
# project's Environment Variables. Never commit the real file.

# Postgres connection string. Provision Neon through the Vercel Marketplace
# (`vercel install neon`) and it is injected automatically — on Vercel you
# normally do not set this by hand.
#
# Leave it UNSET locally and the app uses data/db.json on disk instead.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Admin console password. This is the only credential — the console signs in
# with no email.
#
# It is hashed on first seed and never stored or committed in plaintext.
# Changing it here takes effect on the next request: the stored hash is
# re-derived when it no longer matches (see lib/db.js), so there is no re-seed
# step and no need to touch the database.
#
# If ADMIN_PASSWORD is unset in production a random one is generated and logged
# once at startup, so the account is never left guessable.
ADMIN_PASSWORD=change-me-before-deploying

# Web Push (PWA notifications). Generate a keypair with:
#   npx web-push generate-vapid-keys
#
# Without these the push code is a no-op — in-app notifications still work, the
# toggle on /account just stays hidden. Set all three in production.
#
# The public key is served to the browser at runtime via /api/push/config, so it
# does NOT need a NEXT_PUBLIC_ prefix and can be added after the build.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@teslacapital.io
